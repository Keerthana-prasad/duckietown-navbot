# Environment Configuration for Duckiebot System
# Rename this file to .env and populate your actual secrets
# NEVER commit your actual .env with API keys to Git

# LLM Provider Configuration
# Choose one or both depending on config.yaml
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Robot Network Configuration
ROBOT_NAME=entebot209
ROBOT_HOSTNAME=entebot209.local
ROBOT_SSH_USER=duckie
ROBOT_SSH_PASSWORD=quackquack

# Safety Overrides
# Must explicitly be set to "true" to allow physical wheel movement
ENABLE_PHYSICAL_MOVEMENT=false
DUCKIEBOT_MODE=simulation
